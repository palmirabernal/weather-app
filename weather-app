<script>
  (function initSkycast() {
    (function initLiveWeather() {
      const cityList = document.getElementById('city-list');
      const cityInput = document.getElementById('city-search-input');
      const citySearchStatus = document.getElementById('city-search-status');
      const weatherStatus = document.getElementById('weather-status');
      const modal = document.getElementById('city-modal');
      const modalContent = document.getElementById('city-modal-content');
      let currentUnit = 'c';
      let selectedPlace = {
        name: 'New York',
        admin1: 'New York',
        country: 'United States',
        latitude: 40.7128,
        longitude: -74.006
      };
      let forecastData = null;
      let searchTimer = null;
      let searchController = null;
      let forecastController = null;
      let searchVersion = 0;
      let forecastVersion = 0;

      const weatherCodes = {
        0: ['clear sky', 'sunny'],
        1: ['mostly clear', 'sunny'],
        2: ['partly cloudy', 'partly_cloudy_day'],
        3: ['overcast', 'cloud'],
        45: ['foggy', 'foggy'],
        48: ['foggy', 'foggy'],
        51: ['light drizzle', 'rainy'],
        53: ['drizzle', 'rainy'],
        55: ['heavy drizzle', 'rainy'],
        56: ['freezing drizzle', 'ac_unit'],
        57: ['freezing drizzle', 'ac_unit'],
        61: ['light rain', 'rainy'],
        63: ['rain', 'rainy'],
        65: ['heavy rain', 'rainy'],
        66: ['freezing rain', 'ac_unit'],
        67: ['freezing rain', 'ac_unit'],
        71: ['light snow', 'weather_snowy'],
        73: ['snow', 'weather_snowy'],
        75: ['heavy snow', 'weather_snowy'],
        77: ['snow grains', 'weather_snowy'],
        80: ['light rain showers', 'rainy'],
        81: ['rain showers', 'rainy'],
        82: ['heavy rain showers', 'rainy'],
        85: ['snow showers', 'weather_snowy'],
        86: ['heavy snow showers', 'weather_snowy'],
        95: ['thunderstorm', 'thunderstorm'],
        96: ['thunderstorm with hail', 'thunderstorm'],
        99: ['thunderstorm with hail', 'thunderstorm']
      };
      const windDirections = ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];

      function getWeather(code, isDay) {
        const result = weatherCodes[code] || ['unknown conditions', 'cloud'];
        return {
          text: result[0],
          icon: code === 0 && !isDay ? 'bedtime' : result[1]
        };
      }

      function displayName(place) {
        return [place.name, place.admin1, place.country]
          .filter((part, index, parts) => part && parts.indexOf(part) === index)
          .join(', ');
      }

      function formatTemperature(value) {
        if (!Number.isFinite(value)) return '--';
        const converted = currentUnit === 'f' ? (value * 9) / 5 + 32 : value;
        return `${Math.round(converted)}°`;
      }

      function formatTime(value) {
        if (!value) return '--';
        const match = value.match(/T(\d{2}):(\d{2})/);
        if (!match) return '--';
        const hour = Number(match[1]);
        const suffix = hour >= 12 ? 'pm' : 'am';
        return `${hour % 12 || 12}:${match[2]} ${suffix}`;
      }

      function getHourlyIndex(hourly, currentTime) {
        const index = hourly.time.findIndex(time => time >= currentTime);
        return index < 0 ? Math.max(0, hourly.time.length - 1) : index;
      }

      function showWeatherError(message) {
        weatherStatus.textContent = message;
        weatherStatus.classList.add('text-error');
      }

      function createHourlyCard(hourly, index, offset) {
        const card = document.createElement('div');
        card.className = offset === 0
          ? 'flex-shrink-0 w-20 py-3 px-1.5 rounded-DEFAULT bg-surface-container-lowest shadow-[0_6px_20px_-4px_rgba(251,113,133,0.18)] flex flex-col items-center justify-between gap-1 text-center'
          : 'flex-shrink-0 w-20 py-3 px-1.5 rounded-DEFAULT bg-surface-container-lowest/70 backdrop-blur-md shadow-[0_2px_10px_rgba(0,0,0,0.02)] flex flex-col items-center justify-between gap-1 text-center';
        const date = new Date(`${hourly.time[index]}:00Z`);
        const hour = date.getUTCHours();
        const isDay = hour >= 6 && hour < 20;
        const weather = getWeather(hourly.weather_code[index], isDay);
        const timeLabel = document.createElement('span');
        timeLabel.className = 'font-label-sm text-label-sm lowercase text-primary';
        timeLabel.textContent = offset === 0 ? 'now' : formatTime(hourly.time[index]);
        const icon = document.createElement('span');
        icon.className = 'material-symbols-outlined text-[20px] text-primary';
        icon.textContent = weather.icon;
        const temperature = document.createElement('span');
        temperature.className = 'font-headline-md text-headline-md text-on-surface';
        temperature.textContent = formatTemperature(hourly.temperature_2m[index]);
        const details = document.createElement('span');
        details.className = 'font-label-sm text-[9px] text-on-surface-variant';
        details.textContent = `${hourly.relative_humidity_2m[index]}% · ${Math.round(hourly.wind_speed_10m[index])} km/h`;
        const rain = document.createElement('span');
        rain.className = 'font-label-sm text-[10px] text-outline lowercase';
        rain.textContent = `${hourly.precipitation_probability[index] || 0}% rain`;
        card.append(timeLabel, icon, temperature, details, rain);
        return card;
      }

      function renderForecast(data) {
        const current = data.current;
        const hourly = data.hourly;
        const daily = data.daily;
        const hourlyIndex = getHourlyIndex(hourly, current.time);
        const currentWeather = getWeather(current.weather_code, current.is_day === 1);
        const currentTemp = formatTemperature(current.temperature_2m);
        const apparentTemp = formatTemperature(current.apparent_temperature);
        const high = formatTemperature(daily.temperature_2m_max[0]);
        const low = formatTemperature(daily.temperature_2m_min[0]);
        const windDirection = windDirections[Math.round(current.wind_direction_10m / 22.5) % 16];
        const uvIndex = hourly.uv_index[hourlyIndex];
        const visibilityKm = hourly.visibility[hourlyIndex] / 1000;
        const dewPoint = hourly.dew_point_2m[hourlyIndex];

        document.getElementById('hero-temp').textContent = currentTemp.replace('°', '');
        document.getElementById('hero-location').textContent = displayName(selectedPlace);
        document.getElementById('quick-city-badge').textContent = selectedPlace.name;
        document.getElementById('hero-condition').textContent = currentWeather.text;
        document.getElementById('hero-extremes').textContent = `feels like ${apparentTemp} · high: ${high} · low: ${low}`;
        document.getElementById('hero-summary').textContent = `${currentWeather.text}. Wind is ${windDirection} at ${Math.round(current.wind_speed_10m)} km/h.`;
        document.getElementById('hero-date').textContent = new Intl.DateTimeFormat('en', {
          weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC'
        }).format(new Date(`${current.time.slice(0, 10)}T12:00:00Z`));
        weatherStatus.classList.remove('text-error');
        weatherStatus.textContent = `Updated at ${formatTime(current.time)} local time.`;

        document.getElementById('metric-humidity').textContent = `${current.relative_humidity_2m}%`;
        document.getElementById('humidity-detail').textContent = `Dew point: ${formatTemperature(dewPoint)}.`;
        document.getElementById('metric-wind').textContent = `${Math.round(current.wind_speed_10m)} km/h`;
        document.getElementById('wind-detail').textContent = `${windDirection} · gusts up to ${Math.round(current.wind_gusts_10m)} km/h.`;
        document.getElementById('metric-uv').textContent = Number.isFinite(uvIndex) ? `${uvIndex.toFixed(1)} ${uvIndex < 3 ? 'low' : uvIndex < 6 ? 'moderate' : uvIndex < 8 ? 'high' : 'very high'}` : '--';
        const maxUv = daily.uv_index_max[0];
        document.getElementById('uv-detail').textContent = Number.isFinite(maxUv) ? `Today's highest UV: ${maxUv.toFixed(1)}.` : 'UV forecast unavailable.';
        document.getElementById('metric-vis').textContent = `${visibilityKm.toFixed(1)} km`;
        document.getElementById('visibility-detail').textContent = visibilityKm >= 10 ? 'Good visibility.' : 'Reduced visibility.';

        const hourlyTrack = document.getElementById('hourly-track');
        hourlyTrack.replaceChildren();
        for (let offset = 0; offset < 24 && hourlyIndex + offset < hourly.time.length; offset++) {
          hourlyTrack.appendChild(createHourlyCard(hourly, hourlyIndex + offset, offset));
        }

        const dailyMinValues = daily.temperature_2m_min;
        const dailyMaxValues = daily.temperature_2m_max;
        const minForecast = Math.min(...dailyMinValues);
        const maxForecast = Math.max(...dailyMaxValues);
        const tempRange = Math.max(1, maxForecast - minForecast);
        document.querySelectorAll('.daily-min').forEach((minEl, index) => {
          if (index >= daily.time.length) return;
          const row = minEl.parentElement.parentElement;
          const label = row.children[0];
          const icon = row.children[1].children[0];
          const condition = row.children[1].children[1];
          const fill = row.querySelector('.bg-gradient-to-r');
          const lowValue = dailyMinValues[index];
          const highValue = dailyMaxValues[index];
          const dailyWeather = getWeather(daily.weather_code[index], true);
          const date = new Date(`${daily.time[index]}T12:00:00Z`);
          label.textContent = index === 0 ? 'today' : new Intl.DateTimeFormat('en', { weekday: 'short', timeZone: 'UTC' }).format(date);
          icon.textContent = dailyWeather.icon;
          condition.textContent = dailyWeather.text;
          minEl.textContent = formatTemperature(lowValue);
          row.querySelector('.daily-max').textContent = formatTemperature(highValue);
          if (fill) {
            fill.style.left = `${((lowValue - minForecast) / tempRange) * 100}%`;
            fill.style.right = `${100 - ((highValue - minForecast) / tempRange) * 100}%`;
          }
        });

        document.getElementById('sunrise-time').textContent = formatTime(daily.sunrise[0]);
        document.getElementById('sunset-time').textContent = formatTime(daily.sunset[0]);
        const sunriseMinutes = Number(daily.sunrise[0].slice(11, 13)) * 60 + Number(daily.sunrise[0].slice(14, 16));
        const sunsetMinutes = Number(daily.sunset[0].slice(11, 13)) * 60 + Number(daily.sunset[0].slice(14, 16));
        const solarNoonMinutes = Math.floor((sunriseMinutes + sunsetMinutes) / 2);
        const solarNoonTime = `${daily.sunrise[0].slice(0, 10)}T${String(Math.floor(solarNoonMinutes / 60)).padStart(2, '0')}:${String(solarNoonMinutes % 60).padStart(2, '0')}`;
        document.getElementById('solar-noon-time').textContent = `solar noon ${formatTime(solarNoonTime)}`;
        const daylightHours = Math.floor((sunsetMinutes - sunriseMinutes) / 60);
        const daylightMinutes = (sunsetMinutes - sunriseMinutes) % 60;
        document.getElementById('daylight-duration').textContent = `Daylight ${daylightHours}h ${daylightMinutes}m`;

        document.getElementById('hero-sun').style.opacity = current.is_day ? '1' : '0.35';
        document.getElementById('hero-sun').setAttribute('aria-label', currentWeather.text);
      }

      async function loadWeather(place) {
        selectedPlace = place;
        const requestVersion = ++forecastVersion;
        if (forecastController) forecastController.abort();
        forecastController = new AbortController();
        forecastData = null;
        clearWeatherDisplay();
        document.getElementById('hero-location').textContent = displayName(place);
        document.getElementById('quick-city-badge').textContent = place.name;
        weatherStatus.classList.remove('text-error');
        weatherStatus.textContent = 'Loading weather...';
        try {
          const params = new URLSearchParams({
            latitude: place.latitude,
            longitude: place.longitude,
            current: 'temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m',
            hourly: 'temperature_2m,relative_humidity_2m,wind_speed_10m,precipitation_probability,weather_code,visibility,uv_index,dew_point_2m',
            daily: 'weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,uv_index_max',
            forecast_days: '7',
            timezone: 'auto',
            temperature_unit: 'celsius',
            wind_speed_unit: 'kmh'
          });
          const response = await fetch(`https://api.open-meteo.com/v1/forecast?${params}`, { signal: forecastController.signal });
          if (!response.ok) throw new Error(`Weather request failed (${response.status}).`);
          const data = await response.json();
          if (requestVersion !== forecastVersion) return;
          if (!data.current || !data.hourly || !data.daily) throw new Error('The weather service returned incomplete data.');
          forecastData = data;
          renderForecast(data);
        } catch (error) {
          if (error.name === 'AbortError' || requestVersion !== forecastVersion) return;
          showWeatherError(`${error.message || 'Weather could not be loaded.'} Use VS Code Live Server and check your internet connection.`);
        }
      }

      function showCityMessage(message) {
        cityList.replaceChildren();
        const note = document.createElement('p');
        note.className = 'p-2 text-sm text-on-surface-variant';
        note.textContent = message;
        cityList.appendChild(note);
      }

      async function searchCities(query) {
        const requestVersion = ++searchVersion;
        if (searchController) searchController.abort();
        if (query.length < 2) {
          citySearchStatus.textContent = '';
          showCityMessage('Type at least 2 letters to search.');
          return;
        }
        searchController = new AbortController();
        citySearchStatus.textContent = 'Searching...';
        showCityMessage('Looking for cities...');
        try {
          const params = new URLSearchParams({ name: query, count: '8', language: 'en', format: 'json' });
          const response = await fetch(`https://geocoding-api.open-meteo.com/v1/search?${params}`, { signal: searchController.signal });
          if (!response.ok) throw new Error(`City search failed (${response.status}).`);
          const data = await response.json();
          if (requestVersion !== searchVersion) return;
          const places = data.results || [];
          citySearchStatus.textContent = places.length ? 'Choose a city.' : 'No cities found.';
          cityList.replaceChildren();
          places.forEach(place => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'city-option flex items-center justify-between p-2.5 rounded-DEFAULT bg-surface-container-lowest hover:bg-surface-container-low transition-colors text-left';
            const details = document.createElement('span');
            details.className = 'font-headline-md text-headline-md lowercase text-on-surface';
            details.textContent = displayName(place);
            button.appendChild(details);
            button.addEventListener('click', () => {
              closeModal();
              loadWeather(place);
            });
            cityList.appendChild(button);
          });
          if (!places.length) showCityMessage('No cities found. Try another spelling.');
        } catch (error) {
          if (error.name === 'AbortError' || requestVersion !== searchVersion) return;
          citySearchStatus.textContent = 'Search failed.';
          showCityMessage(`${error.message || 'Could not search for cities.'} Use Live Server and check your internet connection.`);
        }
      }

      function openModal() {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100');
        modalContent.classList.remove('-translate-y-4');
        modalContent.classList.add('translate-y-0');
        cityInput.value = '';
        citySearchStatus.textContent = '';
        showCityMessage('Type at least 2 letters to search.');
        cityInput.focus();
      }

      function closeModal() {
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.classList.remove('opacity-100');
        modalContent.classList.add('-translate-y-4');
        modalContent.classList.remove('translate-y-0');
      }

      function clearWeatherDisplay() {
        document.getElementById('hero-temp').textContent = '--';
        document.getElementById('hero-date').textContent = 'loading local time...';
        document.getElementById('hero-condition').textContent = 'waiting for weather...';
        document.getElementById('hero-extremes').textContent = '--';
        document.getElementById('hero-summary').textContent = 'Current weather will appear here.';
        document.getElementById('metric-humidity').textContent = '--';
        document.getElementById('humidity-detail').textContent = 'Humidity.';
        document.getElementById('metric-wind').textContent = '--';
        document.getElementById('wind-detail').textContent = 'Wind speed.';
        document.getElementById('metric-uv').textContent = '--';
        document.getElementById('uv-detail').textContent = 'UV index.';
        document.getElementById('metric-vis').textContent = '--';
        document.getElementById('visibility-detail').textContent = 'Visibility.';
        document.getElementById('hourly-track').replaceChildren();
        document.querySelectorAll('.daily-min').forEach(element => { element.textContent = '--'; });
        document.querySelectorAll('.daily-max').forEach(element => { element.textContent = '--'; });
        document.querySelectorAll('.daily-min').forEach(element => {
          const row = element.parentElement.parentElement;
          row.children[0].textContent = '--';
          row.children[1].children[0].textContent = 'more_horiz';
          row.children[1].children[1].textContent = 'loading...';
        });
        document.getElementById('sunrise-time').textContent = '--';
        document.getElementById('sunset-time').textContent = '--';
        document.getElementById('solar-noon-time').textContent = 'solar noon --';
        document.getElementById('daylight-duration').textContent = 'Daylight --';
      }

      function updateUnitButtons() {
        const celsiusButton = document.getElementById('unit-c-btn');
        const fahrenheitButton = document.getElementById('unit-f-btn');
        celsiusButton.className = currentUnit === 'c'
          ? 'h-6 px-2 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm lowercase transition-all'
          : 'h-6 px-2 rounded-full text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm lowercase transition-all';
        fahrenheitButton.className = currentUnit === 'f'
          ? 'h-6 px-2 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm lowercase transition-all'
          : 'h-6 px-2 rounded-full text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm lowercase transition-all';
      }

      const openModalButton = document.getElementById('open-city-modal-btn');
      const headerSearchButton = document.getElementById('header-city-search');
      const closeModalButton = document.getElementById('close-city-modal');
      openModalButton.addEventListener('click', openModal);
      headerSearchButton.addEventListener('click', event => {
        event.preventDefault();
        openModal();
      });
      closeModalButton.addEventListener('click', closeModal);
      modal.addEventListener('click', event => {
        if (event.target === modal) closeModal();
      });
      cityInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        if (searchController) searchController.abort();
        searchTimer = setTimeout(() => searchCities(cityInput.value.trim()), 300);
      });
      document.querySelectorAll('.quick-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          openModal();
          cityInput.value = chip.getAttribute('data-switch');
          searchCities(cityInput.value);
        });
      });
      document.getElementById('unit-c-btn').addEventListener('click', () => {
        currentUnit = 'c';
        updateUnitButtons();
        if (forecastData) renderForecast(forecastData);
      });
      document.getElementById('unit-f-btn').addEventListener('click', () => {
        currentUnit = 'f';
        updateUnitButtons();
        if (forecastData) renderForecast(forecastData);
      });
      cityList.replaceChildren();
      showCityMessage('Type at least 2 letters to search.');
      updateUnitButtons();
      clearWeatherDisplay();
      loadWeather(selectedPlace);
    })();
    return;

    let currentUnit = 'c'; // 'c' or 'f'
    let currentCityKey = 'san francisco';

    const cityData = {
      'san francisco': {
        name: 'san francisco, ca',
        badge: 'san francisco',
        tempC: 18,
        condition: 'partly cloudy',
        extremesC: 'feels like 17° · h: 21° l: 13°',
