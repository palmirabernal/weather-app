    function toF(c) {
      return Math.round((c * 9) / 5 + 32);
    }

    function renderDisplay() {
      const city = cityData[currentCityKey];
      if (!city) return;

      const heroTempEl = document.getElementById('hero-temp');
      const heroLocEl = document.getElementById('hero-location');
      const heroCondEl = document.getElementById('hero-condition');
      const heroExtremesEl = document.getElementById('hero-extremes');
      const heroSummaryEl = document.getElementById('hero-summary');
      const quickBadgeEl = document.getElementById('quick-city-badge');

      const metricHumEl = document.getElementById('metric-humidity');
      const metricWindEl = document.getElementById('metric-wind');
      const metricUvEl = document.getElementById('metric-uv');
      const metricVisEl = document.getElementById('metric-vis');

      // Update City Text
      heroLocEl.textContent = city.name;
      quickBadgeEl.textContent = city.badge;
      heroCondEl.textContent = city.condition;
      heroSummaryEl.textContent = city.summary;

      metricHumEl.textContent = city.humidity;
      metricWindEl.textContent = city.wind;
      metricUvEl.textContent = city.uv;
      metricVisEl.textContent = city.vis;

      // Hero Temperature Value
      const currentTemp = currentUnit === 'c' ? city.tempC : toF(city.tempC);
      heroTempEl.textContent = currentTemp;

      // Update Extremes
      if (currentUnit === 'c') {
        heroExtremesEl.textContent = city.extremesC;
      } else {
        const parts = city.extremesC.match(/\d+/g);
        if (parts && parts.length >= 3) {
          heroExtremesEl.textContent = `feels like ${toF(parseInt(parts[0]))}° · h: ${toF(parseInt(parts[1]))}° l: ${toF(parseInt(parts[2]))}°`;
        }
      }

      // Update Hourly Track Elements
      const hourlyCards = document.querySelectorAll('.hourly-val');
      hourlyCards.forEach((card, index) => {
        const baseC = city.hourlyBase[index] || parseInt(card.getAttribute('data-base-c') || '18');
        const val = currentUnit === 'c' ? baseC : toF(baseC);
        card.textContent = `${val}°`;
      });

      // Update 7-Day Forecast Min/Max Elements
      const minPills = document.querySelectorAll('.daily-min');
      minPills.forEach(pill => {
        const baseC = parseInt(pill.getAttribute('data-base-c') || '12');
        pill.textContent = `${currentUnit === 'c' ? baseC : toF(baseC)}°`;
      });

      const maxPills = document.querySelectorAll('.daily-max');
      maxPills.forEach(pill => {
        const baseC = parseInt(pill.getAttribute('data-base-c') || '20');
        pill.textContent = `${currentUnit === 'c' ? baseC : toF(baseC)}°`;
      });

      // Update Unit Toggle Buttons Styling
      const btnC = document.getElementById('unit-c-btn');
      const btnF = document.getElementById('unit-f-btn');
      if (currentUnit === 'c') {
        btnC.className = 'h-6 px-2 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm lowercase transition-all';
        btnF.className = 'h-6 px-2 rounded-full text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm lowercase transition-all';
      } else {
        btnF.className = 'h-6 px-2 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm lowercase transition-all';
        btnC.className = 'h-6 px-2 rounded-full text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm lowercase transition-all';
      }
    }

    // Modal Interaction Handlers
    const modal = document.getElementById('city-modal');
    const modalContent = document.getElementById('city-modal-content');
    const openModalBtn = document.getElementById('open-city-modal-btn');
    const closeModalBtn = document.getElementById('close-city-modal');
    const cityInput = document.getElementById('city-search-input');

    function openModal() {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modalContent.classList.remove('-translate-y-4');
      modalContent.classList.add('translate-y-0');
      if (cityInput) cityInput.focus();
    }

    function closeModal() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modalContent.classList.add('-translate-y-4');
      modalContent.classList.remove('translate-y-0');
      if (cityInput) cityInput.value = '';
      filterCities('');
    }

    if (openModalBtn) openModalBtn.addEventListener('click', openModal);
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // City Selection Buttons inside Modal
    const cityOptionBtns = document.querySelectorAll('.city-option');
    cityOptionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cityKey = btn.getAttribute('data-city');
        if (cityKey && cityData[cityKey]) {
          currentCityKey = cityKey;
          renderDisplay();
          closeModal();
        }
      });
    });

    // Quick Chips Selection
    const quickChips = document.querySelectorAll('.quick-chip');
    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const cityKey = chip.getAttribute('data-switch');
        if (cityKey && cityData[cityKey]) {
          currentCityKey = cityKey;
          renderDisplay();
        }
      });
    });

    // Live search filtering
    function filterCities(query) {
      const q = query.toLowerCase().trim();
      cityOptionBtns.forEach(btn => {
        const cityKey = btn.getAttribute('data-city') || '';
        if (cityKey.includes(q)) {
          btn.style.display = 'flex';
        } else {
          btn.style.display = 'none';
        }
      });
    }

    if (cityInput) {
      cityInput.addEventListener('input', (e) => {
        filterCities(e.target.value);
      });
    }

    // Unit Switch Buttons
    const btnC = document.getElementById('unit-c-btn');
    const btnF = document.getElementById('unit-f-btn');

    if (btnC) {
      btnC.addEventListener('click', () => {
        if (currentUnit !== 'c') {
          currentUnit = 'c';
          renderDisplay();
        }
      });
    }

    if (btnF) {
      btnF.addEventListener('click', () => {
        if (currentUnit !== 'f') {
          currentUnit = 'f';
          renderDisplay();
        }
      });
    }

    // Initial render
    renderDisplay();
  })();
